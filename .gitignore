# Игнорировать папки сборки
bin/
obj/
out/

# Игнорировать файлы пользовательских настроек
*.user
*.userosscache
*.suo
*.cache
*.vs/
.vs/

# Игнорировать файлы, создаваемые ReSharper или другими инструментами
_ReSharper*/
*.ReSharper
*.DotSettings.user

# Игнорировать локальные конфигурации (если config.xml содержит локальные пути)
# Раскомментируйте следующую строку, если не хотите хранить config.xml в репозитории:
# config.xml

# Игнорировать результаты тестов
TestResults/
*.trx

# Игнорировать логи и дампы
*.log
*.diagsession
*.dmp

# Игнорировать пакеты NuGet (если не используется PackageReference)
packages/
*.nupkg

# Игнорировать скомпилированные сборки
*.dll
*.exe
*.exe.config
*.pdb

# Игнорировать файлы отладки
*.ilk
*.obj
*.iobj
*.ipdb
*.idb
*.pgc
*.pgd
*.meta

# Игнорировать временные файлы ОС
Thumbs.db
.DS_Store

# Игнорировать файлы резервных копий
*~
*.bak
*.tmp